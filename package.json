{
  "name": "videomap-pro",
  "version": "1.0.0",
  "description": "Windows PC 视频映射播放软件",
  "main": "dist-electron/main.js",
  "author": "Arkaos",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "compile": "tsc --noEmit && vite build",
    "build:win": "npm run compile && electron-builder --win --config electron-builder.yml --publish never",
    "build": "npm run build:win",
    "prune:deps": "npm prune --omit=dev",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-build.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
